{
  "name": "Meeting Notes → Action Items (AI)",
  "nodes": [
    {
      "parameters": {
        "content": "## Meeting Notes → Action Items\nPOST a transcript to the webhook. GPT extracts summary, decisions, action items and risks as JSON.\nAction items become Trello cards + a Google Sheets log; a recap goes to Slack.\n\n**Credentials needed:** OpenAI, Trello, Slack, Google Sheets",
        "height": 220,
        "width": 420
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-notes",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Webhook - Transcript In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "7d2c6a8e-3b1f-4c5a-9e2d-1a0b3c4d5e61"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are a senior project coordinator. Read the meeting transcript and return ONLY valid JSON with this shape:\n{\"summary\": \"3-4 sentence summary\", \"decisions\": [\"...\"], \"action_items\": [{\"task\": \"...\", \"owner\": \"name or Unassigned\", \"due_date\": \"YYYY-MM-DD or null\", \"priority\": \"High|Medium|Low\"}], \"risks\": [\"...\"]}\nRules: only include action items someone committed to or that were clearly assigned. Convert relative dates (e.g. 'next Friday') using the meeting date. Never invent owners or dates - use \"Unassigned\" or null.",
              "role": "system"
            },
            {
              "content": "=Meeting: {{ $json.body.meeting_title }}\nDate: {{ $json.body.meeting_date }}\nAttendees: {{ $json.body.attendees.join(', ') }}\n\nTranscript:\n{{ $json.body.transcript }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "OpenAI - Extract Actions",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "meeting_title",
              "value": "={{ $('Webhook - Transcript In').item.json.body.meeting_title }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "summary",
              "value": "={{ $json.message.content.summary }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "decisions",
              "value": "={{ $json.message.content.decisions }}",
              "type": "array"
            },
            {
              "id": "f4",
              "name": "action_items",
              "value": "={{ $json.message.content.action_items }}",
              "type": "array"
            },
            {
              "id": "f5",
              "name": "risks",
              "value": "={{ $json.message.content.risks }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Set - Clean Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#project-updates",
          "mode": "name"
        },
        "text": "=:memo: *{{ $json.meeting_title }}*\n\n*Summary*\n{{ $json.summary }}\n\n*Decisions*\n{{ $json.decisions.map(d => '• ' + d).join('\\n') }}\n\n*Action items*\n{{ $json.action_items.map(a => '• ' + a.task + ' — ' + (a.owner === 'Unassigned' ? ':warning: *Unassigned*' : a.owner) + (a.due_date ? ' (due ' + a.due_date + ')' : '')).join('\\n') }}\n\n*Risks*\n{{ $json.risks.map(r => '• ' + r).join('\\n') }}",
        "otherOptions": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Slack - Post Recap",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [680, -200]
    },
    {
      "parameters": {
        "fieldToSplitOut": "action_items",
        "include": "selectedOtherFields",
        "fieldsToInclude": "meeting_title",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Split Out - Action Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 0]
    },
    {
      "parameters": {
        "listId": "",
        "name": "={{ $json.task }}",
        "description": "=Owner: {{ $json.owner }}\nPriority: {{ $json.priority }}\nSource meeting: {{ $json.meeting_title }}",
        "additionalFields": {
          "due": "={{ $json.due_date ? $json.due_date + 'T17:00:00' : '' }}"
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Trello - Create Card",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [920, -80]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "Action Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "meeting_title": "={{ $('Split Out - Action Items').item.json.meeting_title }}",
            "task": "={{ $('Split Out - Action Items').item.json.task }}",
            "owner": "={{ $('Split Out - Action Items').item.json.owner }}",
            "due_date": "={{ $('Split Out - Action Items').item.json.due_date }}",
            "priority": "={{ $('Split Out - Action Items').item.json.priority }}",
            "logged_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Google Sheets - Action Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [920, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', meeting: $json.meeting_title, action_items: $json.action_items.length, decisions: $json.decisions.length } }}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 200]
    }
  ],
  "connections": {
    "Webhook - Transcript In": {
      "main": [[{ "node": "OpenAI - Extract Actions", "type": "main", "index": 0 }]]
    },
    "OpenAI - Extract Actions": {
      "main": [[{ "node": "Set - Clean Fields", "type": "main", "index": 0 }]]
    },
    "Set - Clean Fields": {
      "main": [[
        { "node": "Slack - Post Recap", "type": "main", "index": 0 },
        { "node": "Split Out - Action Items", "type": "main", "index": 0 },
        { "node": "Respond to Webhook", "type": "main", "index": 0 }
      ]]
    },
    "Split Out - Action Items": {
      "main": [[
        { "node": "Trello - Create Card", "type": "main", "index": 0 },
        { "node": "Google Sheets - Action Log", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
